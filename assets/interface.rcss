/* === Style Reference ===
std-font-size: 14px
large-font-size: 20px
small-font-size: 18px

primary-color: #3a4f63
secondary-color: #2c3e50
btn-highlight-color: #00aced
btn-highlight-hover-color: #0091c9
btn-color: #34495e
warning-color: #c0392b
========================== */

body {
    margin: 0;
    font-family: "Comic Sans MS";
    background-color: #3a4f63;
    color: white;
    height: 100vh;
    width: 100vw;
    display: flex;
    flex-direction: column;
}

.menu-bar {
    display: flex;
    background-color: #2c3e50;
    padding: 0 10px;
    align-items: center;
    height: 40px;
}

.menu-item {
    background-color: #2c3e50;
    font-size: 16px;
    position: relative;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 8px;
    transition: background-color 0.2s cubic-in-out;
}

.menu-item:hover {
    background-color: #00aced;
}

.dropdown {
    display: none;
    position: absolute;
    top: 39px;
    left: 0;
    background-color: #34495e;
    min-width: 180px;
    border-radius: 0 0 6px 6px;
    flex-direction: column;
    border-radius: 5px;
}

.menu-item:hover .dropdown {
    display: flex;
}

.dropdown button {
    background-color: transparent;
    padding: 6px 12px;
    color: white;
    border-radius: 5px;
}

.dropdown button:hover {
    background-color: #00aced;
    border-radius: 5px;
}

.main-container {
    flex: 1;
    display: flex;
}

.scene-panel {
    width: 220px;
    background-color: #3a4f63;
    display: flex;
    flex-direction: column;
    padding: 10px;
    gap: 10px;
}

.scene-title {
    font-size: 18px;
    text-align: center;
}

.scene-list {
    flex: 1;
    background-color: #2c3e50;
    border-radius: 6px;
    overflow-y: auto;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}
.scene-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.scene-header button {
    background-color: #00aced;
    color: white;
    border-radius: 6px;
    padding: 6px 10px;
    cursor: pointer;
}

.scene-header button:hover {
    background-color: #0091c9;
}

.scene-item {
    background-color: #34495e;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 18px;
}

.scene-item:hover {
    background-color: #00aced;
}

.scene-buttons {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.scene-buttons button {
    background-color: #00aced;
    color: white;
    border-width: 0;
    border-radius: 6px;
    padding: 6px;
}

.scene-buttons button:hover {
    background-color: #0091c9;
}

.main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 15px;
    gap: 15px;
}

.projector-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    height: 100%;
    align-content: stretch; /* lets rows stretch to fill vertical space */
}


.projector {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-basis: 30%;
    max-width: 33%;
    flex-grow: 1;
    min-height: 120px;
    background-color: #00aced;
    border-radius: 12px;
    color: white;
    font-size: 16px;
    overflow: hidden;
}


.projector:hover {
    background-color: #00aced;
}

#project-name {
    font-size: 36px;
    font-weight: 600;
    text-align: center;
    flex: 1;
}


.main-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
}

.logo img {
    height: 40px;
}

.to-right-buttons {
    display: flex;
    gap: 10px;
}

.top-right-buttons button {
    background-color: #00aced;
    color: white;
    border-width: 0;
    border-radius: 6px;
    padding: 6px 12px;
}

.test-control {
    display: flex;
    gap: 10px;
    justify-content: flex-start;
    align-items: center;
}

.test-control button {
    border-width: 0;
    border-radius: 6px;
    padding: 6px 12px;
}

.test-control .remove-btn {
    background-color: #c0392b;
}
.scene-item {
    background-color: #34495e;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 18px;
}

.scene-item:hover {
    background-color: #0091c9;
}

.scene-item.active {
    background-color: #00aced;
    border-top: 2px #3a4f63;
    border-right: 2px #3a4f63;
    border-bottom: 2px #3a4f63;
    border-left: 2px #3a4f63;
    border-radius: 4px;
}

.context-menu-item {
    display: block;
    width: 100%; /* This makes it fill the container */
    background-color: transparent;
    color: white;
    padding: 12px 20px; /* Increased horizontal padding */
    text-align: left;
    cursor: pointer;
    border-radius: 0; /* Remove border radius from items */
    font-size: 16px;
    box-sizing: border-box; /* Include padding in width calculation */
    border: none; /* Remove any default borders */
    margin: 0; /* Remove any margins */
}

.context-menu-item:first-child {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.context-menu-item:last-child {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.context-menu-item:hover {
    background-color: #3a4f63;
    width: 100%;
}

/* Context menu styling - bigger with border */
.context-menu {
    background-color: #34495e;
    /* RmlUi border syntax for all sides */
    border-top: 5px #2c3e50;
    border-right: 5px #2c3e50;
    border-bottom: 5px #2c3e50;
    border-left: 5px #2c3e50;
    border-radius: 6px; /* Slightly larger border radius */
    padding: 8px 0; /* More padding to make it bigger */
    width: auto;
    z-index: 1000;
    min-width: 150px; /* Minimum width to make it bigger */
}
.scene-item.renaming {
    background-color: #2c3e50 !important;
}

.rename-container {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 5px;
}

.rename-input {
    flex: 1;
    padding: 4px 8px;
    background-color: #34495e;
    color: white;
    border: 1px solid #00aced;
    border-radius: 3px;
}

.rename-ok-button {
    padding: 4px 12px;
    background-color: #00aced;
    color: white;
    border: none;
    border-radius: 3px;
    cursor: pointer;
    white-space: nowrap;
}

.rename-ok-button:hover {
    background-color: #0091c9;
}

.scene-item.renaming {
    background-color: #2c3e50 !important;
    pointer-events: none; /* Disable pointer events on the scene item */
}

.rename-container {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 5px;
    pointer-events: auto; /* Re-enable pointer events for the container */
}

.rename-input, .rename-ok-button {
    pointer-events: auto; /* Ensure input and button are clickable */
}
