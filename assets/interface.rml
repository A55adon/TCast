<rml>
    <head>
        <title>TCast</title>
        <link type="text/rcss" href="interface.rcss"/>
    </head>
    <body id="body" class="window">
    <div class="menu-bar">
        <div class="menu-item">Datei
            <div class="dropdown">
                <button id= "file-dropdown-newproject">Neues Projekt</button>
                <button id= "file-dropdown-loadproject">Projekt öffnen</button>
                <button>Speichern</button>
                <button id= "file-dropdown-save-as">Speichern unter...</button>
                <button id= "file-dropdown-importproject">Importieren (tct)</button>
                <button id= "file-dropdown-exportproject">Exportieren (tct)</button>
                <button id= "file-dropdown-closeproject">Projekt Schließen</button>
                <button id= "file-dropdown-closeprogramm">Beenden</button>
            </div>
        </div>
        <div class="menu-item" id= "settings">Einstellungen</div>
        <div class="menu-item">Hilfe
            <div class="dropdown">
                <button>Dokumentation</button>
                <button>Support</button>
                <button>Credits</button>
            </div>
        </div>
    </div>

    <div class="main-container">
        <div class="scene-panel">
            <div class="scene-header">
                <div class="scene-title">Szenen</div>
                <button id="add-scene-btn">+ Hinzufügen</button>
            </div>

            <div class="scene-list" id="sceneList">
            </div>


            <div class="scene-buttons">
                <button id="scene-buttons-arrow-up">🔼Hoch</button>
                <button id="scene-buttons-arrow-down">🔽Runter</button>
                <button id="scene-buttons-delete-all">Alle löschen</button>
            </div>
        </div>
        <div class="main-area">
            <div class="main-top-bar">
                <div class="logo">
                    <img src="t-cast.svg" alt="Logo" />
                </div>

                <h1 id="project-name" >Error-No-Project-Name-Found</h1>

                <div class="top-right-buttons">
                    <button id="project-sources">
                        <!-- <img src="play.svg" id="play-svg" alt=""/> -->
                    </button>
                    <button id="stop-projection">
                    </button>
                </div>
            </div>
            <div class="main-body" id="main-body">
                <div class="projector-grid" id="projectorGrid">
                    <!-- Projectors will go here -->
                </div>
                <div id="add-resource-dialog">
                    <div class="dialog-box">
                        <label style="font-size:16px; margin-bottom:5px;">Datei auswählen</label>
                        <div style="display:flex; gap:10px; align-items:center;">
                            <input type="text" id="resource-file" placeholder="Pfad wählen" style="flex:1;"/>
                            <button id="browse-png-btn">Wählen</button>
                        </div>
                        <input type="text" id="resource-name" placeholder="Ressourcenname"/>
                        <div style="display:flex; gap:10px; justify-content:flex-end;">
                            <button id="resource-cancel-btn">Abbrechen</button>
                            <button id="resource-confirm-btn">Hinzufügen</button>
                        </div>
                    </div>
                </div>


                <div class="resource-area" id="resource-area">
                    <div class="resource-header">
                        <h2>Ressourcen</h2>
                        <button id="add-resource-btn">+ Hinzufügen</button>

                    </div>
                    <div class="resource-list" id="resource-list">

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="settings-overlay" style="display:none">
        <div class="settings-header">
            <h2>Einstellungen</h2>
            <button id="settings-close" class="close-button">X</button>
        </div>

        <div class="settings-content">
            <!-- Allgemein Section -->
            <div class="settings-section">
                <h3>Allgemein</h3>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Automatische Updates</span>
                        <span class="setting-description">Automatisch nach Updates suchen und installieren</span>
                    </div>
                    <div class="setting-control">
                        <div class="checkbox-container">
                            <input type="checkbox" id="auto-updates" class="setting-checkbox"/>
                            <label for="auto-updates" class="checkbox-label"></label>
                        </div>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Automatisch letztes Projekt öffnen</span>
                        <span class="setting-description">Beim Start das zuletzt geöffnete Projekt laden</span>
                    </div>
                    <div class="setting-control">
                        <div class="checkbox-container">
                            <input type="checkbox" id="auto-last-project" class="setting-checkbox" checked/>
                            <label for="auto-last-project" class="checkbox-label"></label>
                        </div>
                    </div>
                </div>

                <div class="setting-item project-rename-item">
                    <div class="setting-info">
                        <span class="setting-name">Aktuelles Projekt umbenennen</span>
                        <span class="setting-description">Namen des geöffneten Projekts ändern</span>
                    </div>
                    <div class="setting-control rename-control">
                        <input type="text" class="rename-input" value="Mein Projekt" placeholder="Projektname"/>
                        <button class="rename-apply">Apply</button>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Projekt löschen</span>
                        <span class="setting-description warning-text">Aktuelles Projekt dauerhaft entfernen</span>
                    </div>
                    <div class="setting-control">
                        <button class="action-button danger">Löschen</button>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Im Explorer öffnen</span>
                        <span class="setting-description">Projektordner im Datei-Explorer anzeigen</span>
                    </div>
                    <div class="setting-control">
                        <button class="action-button">Öffnen</button>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Projekt reparieren</span>
                        <span class="setting-description">Beschädigte Projektdateien wiederherstellen</span>
                    </div>
                    <div class="setting-control">
                        <button class="action-button">Reparieren</button>
                    </div>
                </div>
            </div>

            <!-- Anzeige Section -->
            <div class="settings-section">
                <h3>Anzeige</h3>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">VSync</span>
                        <span class="setting-description">Bildwiederholrate mit Monitor synchronisieren</span>
                    </div>
                    <div class="setting-control">
                        <div class="checkbox-container">
                            <input type="checkbox" id="vsync" class="setting-checkbox" checked/>
                            <label for="vsync" class="checkbox-label"></label>
                        </div>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">FPS Limit</span>
                        <span class="setting-description">Maximale Bildwiederholrate begrenzen</span>
                    </div>
                    <div class="setting-control">
                        <select class="setting-select">
                            <option value="30">30 FPS</option>
                            <option value="60" selected>60 FPS</option>
                            <option value="120">120 FPS</option>
                            <option value="144">144 FPS</option>
                            <option value="0">Unbegrenzt</option>
                        </select>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Vollbild</span>
                        <span class="setting-description">Im Vollbildmodus ausführen</span>
                    </div>
                    <div class="setting-control">
                        <div class="checkbox-container">
                            <input type="checkbox" id="fullscreen" class="setting-checkbox"/>
                            <label for="fullscreen" class="checkbox-label"></label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Erweitert Section -->
            <div class="settings-section">
                <h3>Erweitert</h3>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Debug-Modus</span>
                        <span class="setting-description">Erweiterte Debug-Informationen anzeigen</span>
                    </div>
                    <div class="setting-control">
                        <div class="checkbox-container">
                            <input type="checkbox" id="debug-mode" class="setting-checkbox"/>
                            <label for="debug-mode" class="checkbox-label"></label>
                        </div>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Unnötige Dateien löschen</span>
                        <span class="setting-description warning-text">Temporäre und Cache-Dateien bereinigen</span>
                    </div>
                    <div class="setting-control">
                        <button class="action-button danger">Jetzt bereinigen</button>
                    </div>
                </div>

                <div class="setting-item">
                    <div class="setting-info">
                        <span class="setting-name">Automatische Bereinigung</span>
                        <span class="setting-description">Täglich temporäre Dateien automatisch löschen</span>
                    </div>
                    <div class="setting-control">
                        <div class="checkbox-container">
                            <input type="checkbox" id="auto-cleanup" class="setting-checkbox"/>
                            <label for="auto-cleanup" class="checkbox-label"></label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="sceneContextMenu" class="context-menu" style="display: none; position: absolute;">
        <button id="scene-context-rename" class="context-menu-item">Umbenennen</button>
        <button id="scene-context-delete" class="context-menu-item">Löschen</button>
        <button id="scene-context-duplicate" class="context-menu-item">Klonen</button>
    </div>
    <div id="resourceContextMenu" class="context-menu" style="display: none; position: absolute;">
        <button id="resource-context-rename" class="context-menu-item">Umbenennen</button>
        <button id="resource-context-delete" class="context-menu-item">Löschen</button>
    </div>
    <div id="projectorContextMenu" class="context-menu" style="display: none; position: absolute;">
        <button id="projector-context-selectResource" class="context-menu-item">Ressource Auswählen</button>
    </div>
    </body>
</rml>
