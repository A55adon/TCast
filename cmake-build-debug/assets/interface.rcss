body {
    margin: 0;
    font-family: "Comic Sans MS";
    background-color: #3a4f63;
    color: white;
    height: 100vh;
    width: 100vw;
    display: flex;
    flex-direction: column;
}

.menu-bar {
    display: flex;
    background-color: #2c3e50;
    padding: 0 10px;
    align-items: center;
    height: 40px;
}

.menu-item {
    background-color: #2c3e50;
    font-size: 16px;
    position: relative;
    padding: 10px 20px;
    cursor: pointer;
    border-radius: 8px;
}

.menu-item:hover {
    background-color: #00aced;
}

.dropdown {
    display: none;
    position: absolute;
    top: 39px;
    left: 0;
    background-color: #34495e;
    min-width: 180px;
    flex-direction: column;
    border-radius: 5px;
}

.menu-item:hover .dropdown {
    display: flex;
}

.dropdown button {
    background-color: transparent;
    padding: 6px 12px;
    color: white;
    border-radius: 5px;
}

.dropdown button:hover {
    background-color: #00aced;
    border-radius: 5px;
}

.main-container {
    flex: 1;
    display: flex;
}

.scene-panel {
    width: 220px;
    background-color: #3a4f63;
    display: flex;
    flex-direction: column;
    padding: 10px;
    gap: 10px;
}

.scene-title {
    font-size: 18px;
    text-align: center;
}

.scene-list {
    flex: 1;
    background-color: #2c3e50;
    border-radius: 6px;
    overflow-y: auto;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.scene-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.scene-header button {
    background-color: #00aced;
    color: white;
    border-radius: 6px;
    padding: 6px 10px;
    cursor: pointer;
}

.scene-header button:hover {
    background-color: #0091c9;
}

.scene-item {
    background-color: #34495e;
    border-radius: 4px;
    padding: 10px 12px;
    font-size: 18px;
}

.scene-item:hover {
    background-color: #0091c9;
}

.scene-item.active {
    background-color: #00aced;
}

.scene-buttons {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.scene-buttons button {
    background-color: #00aced;
    color: white;
    border-radius: 6px;
    padding: 6px;
}

.scene-buttons button:hover {
    background-color: #0091c9;
}

.main-area {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 15px;
    gap: 15px;
}

.projector {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-basis: 30%;
    max-width: 33%;
    flex-grow: 1;
    min-height: 120px;
    background-color: #00aced;
    border-radius: 12px;
    color: white;
    font-size: 16px;
    overflow: hidden;
}

.projector:hover {
    background-color: #00aced;
}

#project-name {
    font-size: 36px;
    font-weight: 600;
    text-align: center;
    flex: 1;
}

.main-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
}

.logo img {
    height: 40px;
}

.top-right-buttons button {
    background-color: #00aced;
    color: white;
    border-radius: 6px;
    padding: 6px 12px;
}

.test-control {
    display: flex;
    gap: 10px;
    justify-content: flex-start;
    align-items: center;
}

.test-control button {
    border-radius: 6px;
    padding: 6px 12px;
}

.test-control .remove-btn {
    background-color: #c0392b;
}

.rename-container {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 5px;
}

.rename-input {
    flex: 1;
    padding: 4px 8px;
    background-color: #34495e;
    color: white;
    border-radius: 3px;
}

.rename-ok-button {
    padding: 4px 12px;
    background-color: #00aced;
    color: white;
    border-radius: 3px;
    cursor: pointer;
}

.rename-ok-button:hover {
    background-color: #0091c9;
}

.scene-item.renaming {
    background-color: #2c3e50;
    pointer-events: none;
}

.rename-container {
    pointer-events: auto;
}

.rename-input, .rename-ok-button {
    pointer-events: auto;
}

.context-menu-item {
    display: block;
    width: 100%;
    background-color: transparent;
    color: white;
    padding: 12px 20px;
    text-align: left;
    cursor: pointer;
    font-size: 16px;
    box-sizing: border-box;
}

.context-menu-item:first-child {
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
}

.context-menu-item:last-child {
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

.context-menu-item:hover {
    background-color: #3a4f63;
    width: 100%;
}

.context-menu {
    background-color: #34495e;
    border-radius: 6px;
    padding: 8px 0;
    width: auto;
    z-index: 1000;
    min-width: 150px;
}

.main-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 15px;
    min-height: 0;
}

.projector-grid {
    flex: 4;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-content: stretch;
    min-height: 0;
}

.resource-area {
    flex: 2;
    background-color: #2c3e50;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-height: 100%;
}

.resource-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 15px;
    background-color: #34495e;
    border-radius: 8px 8px 0 0;
    flex-shrink: 0;
}

.resource-header h2 {
    margin: 0;
    font-size: 18px;
    color: white;
}

#add-resource-btn {
    background-color: #00aced;
    color: white;
    border-radius: 6px;
    padding: 6px 12px;
    cursor: pointer;
    font-size: 14px;
}

#add-resource-btn:hover {
    background-color: #0091c9;
}

.resource-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 10px;
    align-content: flex-start;
    max-height: 260px;
    overflow-y: auto;
    box-sizing: border-box;
}

.resource-item {
    display: flex;
    flex-direction: column;
    width: 150px;
    gap: 6px;
    align-items: center;
}

.resource-item.active {
    background-color: #00aced;
}
.resource-item:hover {
    background-color: #0091c9;
}

.resource-thumbnail {
    width: 100%;
    border-radius: 8px;
    border: none;
    display: block;
}

.resource-name {
    max-width: 100%;
    padding: 4px 8px;
    background: #eee;
    border-radius: 6px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}



.resource-item img {
    width: 88px;
    height: 70px;
    display: block;
}


.resource-item.active {
    background-color: #00aced;
}

#add-resource-dialog {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;
}

#add-resource-dialog .dialog-box {
    background-color: #2c3e50;
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 320px;
    max-width: 400px;
    box-sizing: border-box;
}

#add-resource-dialog input[type="text"] {
    padding: 6px 10px;
    background-color: #34495e;
    color: white;
    font-size: 14px;
    border-radius: 6px;
}

#add-resource-dialog button {
    background-color: #00aced;
    color: white;
    border-radius: 6px;
    padding: 6px 12px;
    cursor: pointer;
    font-size: 14px;
}

#add-resource-dialog button:hover {
    background-color: #0091c9;
}

.resource-item.renaming {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    background-color: #2c3e50;
    padding: 6px;
    border-radius: 8px;
}

.resource-item.renaming .rename-container {
    display: flex;
    width: 100%;
    gap: 4px;
    justify-content: center;
}

.resource-item.renaming .rename-input {
    flex: 1;
    padding: 4px 8px;
    background-color: #34495e;
    color: white;
    border-radius: 4px;
    text-align: left;
}

.resource-item.renaming .rename-ok-button {
    padding: 4px 12px;
    background-color: #00aced;
    color: white;
    border-radius: 4px;
    cursor: pointer;
}

.resource-item.renaming .rename-ok-button:hover {
    background-color: #0091c9;
}

#projector-resource-dialog > #scrollbarvertical {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 10px;
    pointer-events: auto;
}

#scrollbarvertical {
    position:absolute;
}

slidertrack {
}
sliderbar {
}
scrollbarvertical {
     max-width:0px;
 }