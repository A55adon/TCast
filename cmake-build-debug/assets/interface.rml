<rml>
    <head>
        <title>TCast</title>
        <link type="text/rcss" href="interface.rcss"/>
    </head>
    <body id="body" class="window">
    <div class="menu-bar">
        <div class="menu-item">Datei
            <div class="dropdown">
                <button id= "file-dropdown-newproject">Neues Projekt</button>
                <button id= "file-dropdown-loadproject">Projekt öffnen</button>
                <button>Speichern</button>
                <button>Speichern unter...</button>
                <button id= "file-dropdown-importproject">Importieren (tct)</button>
                <button id= "file-dropdown-exportproject">Exportieren (tct)</button>
                <button id= "file-dropdown-closeproject">Projekt Schließen</button>
                <button id= "file-dropdown-closeprogramm">Beenden</button>
            </div>
        </div>
        <div class="menu-item">Einstellungen
            <div class="dropdown">
                <button>Allgemein</button>
                <button>Anzeige</button>
                <button>Projektoren</button>
                <button>Netzwerk</button>
            </div>
        </div>
        <div class="menu-item">Ansicht
            <div class="dropdown">
                <button>Layout zurücksetzen</button>
                <button>Dunkles Theme</button>
                <button>Volle Bildschirmansicht</button>
            </div>
        </div>
        <div class="menu-item">Hilfe
            <div class="dropdown">
                <button>Dokumentation</button>
                <button>Support</button>
                <button>Über</button>
            </div>
        </div>
    </div>

    <div class="main-container">
        <div class="scene-panel">
            <div class="scene-header">
                <div class="scene-title">Szenen</div>
                <button id="add-scene-btn">+ Hinzufügen</button>
            </div>

            <div class="scene-list" id="sceneList">
            </div>


            <div class="scene-buttons">
                <button id="scene-buttons-arrow-up">⮝ Hoch</button>
                <button id="scene-buttons-arrow-down">⮟ Runter</button>
                <button id="scene-buttons-delete-all">Alle löschen</button>
            </div>
        </div>
        <div class="main-area">
            <div class="main-top-bar">
                <div class="logo">
                      <!--<img src="test.jpg" alt="Logo" /> -->
                    <span>TCast</span>
                </div>

                <h1 id="project-name" >Error-No-Project-Name-Found</h1>

                <div class="top-right-buttons">
                    <button>Vorschau</button>
                    <button>Anzeige starten</button>
                    <button>Stop</button>
                </div>
            </div>
            <div class="main-body" id="main-body">
                <div class="projector-grid" id="projectorGrid">
                    <!-- Projectors will go here -->
                </div>
                <div id="add-resource-dialog">
                    <div class="dialog-box">
                        <label style="font-size:16px; margin-bottom:5px;">Datei auswählen</label>
                        <div style="display:flex; gap:10px; align-items:center;">
                            <input type="text" id="resource-file" placeholder="Pfad wählen" style="flex:1;"/>
                            <button id="browse-png-btn">Wählen</button>
                        </div>
                        <input type="text" id="resource-name" placeholder="Ressourcenname"/>
                        <div style="display:flex; gap:10px; justify-content:flex-end;">
                            <button id="resource-cancel-btn">Abbrechen</button>
                            <button id="resource-confirm-btn">Hinzufügen</button>
                        </div>
                    </div>
                </div>


                <div class="resource-area" id="resource-area">
                    <div class="resource-header">
                        <h2>Ressourcen</h2>
                        <button id="add-resource-btn">+ Hinzufügen</button>

                    </div>
                    <div class="resource-list" id="resource-list">

                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="sceneContextMenu" class="context-menu" style="display: none; position: absolute;">
        <button id="scene-context-rename" class="context-menu-item">Rename</button>
        <button id="scene-context-delete" class="context-menu-item">Delete</button>
        <button id="scene-context-duplicate" class="context-menu-item">Duplicate</button>
    </div>
    <div id="resourceContextMenu" class="context-menu" style="display: none; position: absolute;">
        <button id="resource-context-rename" class="context-menu-item">Rename</button>
        <button id="resource-context-delete" class="context-menu-item">Delete</button>
    </div>
    <div id="projectorContextMenu" class="context-menu" style="display: none; position: absolute;">
        <button id="projector-context-selectResource" class="context-menu-item">Select Resource</button>
    </div>
    </body>
</rml>
