body.window {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 20px; /* Added padding around entire window */
    background-color: #2c3e50;
    font-family: "Comic Sans MS";
    color: white;
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box; /* Ensure padding doesn't affect width calculation */
}

h1 {
    font-size: 36px; /* Increased from 28px */
    margin: 25px 0; /* Increased margin */
}

.project-settings-div {
    padding: 30px; /* Increased from 20px */
    border-radius: 12px; /* Increased from 8px */
    background-color: #3a4f63;
    width: 800px; /* Increased from 620px */
    display: flex;
    flex-direction: column;
    gap: 20px; /* Increased from 15px */
}

.tabs {
    display: flex;
    margin-bottom: 12px; /* Increased from 8px */
}

.tab-button {
    flex: 1;
    padding: 14px; /* Increased from 10px */
    background-color: #2c3e50;
    color: white;
    border-radius: 600px;
    font-size: 18px; /* Increased from 15px */
    cursor: pointer;
}

.tab-button.active {
    background-color: #00aced;
    font-weight: bold;
}

.tab-content {
    display: flex;
    flex-direction: column;
    gap: 18px; /* Increased from 12px */
    background-color: #34495e;
    padding: 20px; /* Increased from 14px */
    border-radius: 8px 8px 8px 8px; /* Increased from 6px */
}

.input-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px; /* Increased from 10px */
}

label {
    width: 180px; /* Increased from 140px */
    font-size: 16px; /* Increased from 14px */
}

input, textarea {
    flex: 1;
    padding: 12px 14px; /* Increased from 8px 10px */
    border-radius: 8px; /* Increased from 6px */
    background-color: #2c3e50;
    color: white;
    font-size: 16px; /* Increased from 14px */
}

textarea {
    min-height: 80px; /* Increased from 60px */
    max-height: 200px; /* Increased from 150px */
    line-height: 1.4;
}

.action-btn {
    padding: 14px 18px; /* Increased from 10px 14px */
    font-size: 16px; /* Increased from 14px */
    color: white;
    border-radius: 8px; /* Increased from 6px */
    cursor: pointer;
}

.action-btn:hover {
    background: #33c6f3;
}

.sample-project {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px;
    cursor: pointer;
    position: relative;
}

.trash-btn {
    width: 42px;
    height: 42px;
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;

    background-color: #d85c64;

    opacity: 0;
    pointer-events: none;
}

.sample-project:hover .trash-btn {
    opacity: 1;
    pointer-events: auto;
}

.trash-icon {
    width: 28px;
    height: 28px;
}

.sample-project[data-selected="true"]::after {
    width: 6px;
    height: 100%;
    background-color: rgba(255, 120, 120, 0.6);
    margin-left: 8px;
}

/* Base slider */
input[type="range"] {
    width: 100%;
    height: 24px;
    background-color: transparent;
    margin: 6px 0;
}

/* Track (dark bar) */
input[type="range"] slidertrack {
    height: 6px;
    background-color: #1f2d3a;   /* dark blue */
    border-radius: 999px;
    margin-top: 4px;             /* centers track vertically */
}

/* Knob */
input[type="range"] sliderbar {
    width: 16px;
    height: 16px;
    background-color: #00aced;
    border-radius: 999px;
}

/* Hover feedback */
input[type="range"]:hover sliderbar {
    background-color: #33c6f3;
}

.load-area {
    display: flex;
    flex-direction: row;
    gap: 20px; /* Increased from 15px */
}

.sample-list {
    flex: 1;
    max-height: 250px; /* Increased from 200px */
    overflow-y: auto;
    background-color: #2c3e50;
    padding: 12px; /* Increased from 8px */
    border-radius: 8px; /* Increased from 6px */
    display: flex;
    flex-direction: column;
    gap: 8px; /* Increased from 6px */
}

.sample-project {
    padding: 12px; /* Increased from 8px */
    background-color: #3a4f63;
    border-radius: 6px; /* Increased from 4px */
    cursor: pointer;
    font-size: 16px; /* Added font size */
}

.sample-project:focus {
    background-color: #00aced;
}

.sample-project.active {
    background-color: #27ae60;
    font-weight: bold;
}

.selected-panel {
    width: 240px; /* Increased from 200px */
    background-color: #2c3e50;
    border-radius: 8px; /* Increased from 6px */
    padding: 14px; /* Increased from 10px */
    display: flex;
    flex-direction: column;
    gap: 8px; /* Increased from 6px */
}

button {
    background-color: #00aced;
    color: white;
    border-radius: 8px; /* Increased from 6px */
    padding: 14px 20px; /* Increased from 10px 16px */
    font-size: 18px; /* Increased from 15px */
    font-weight: bold;
    cursor: pointer;
    transition: background-color 0.2s, transform 0.1s;
}

button:hover {
    background-color: #0091c9;
}

button:active {
    transform: scale(0.97);
}

.tab-button {
    flex: 1;
    border-radius: 8px 8px 0 0; /* Increased from 6px */
    background-color: #2c3e50;
    font-weight: normal;
}

.tab-button.active {
    background-color: #00aced;
    font-weight: bold;
}

.load-area {
    display: flex;
    gap: 25px; /* Increased from 20px */
    align-items: flex-start;
    width: 100%;
}

.list-container {
    flex: 2;
    display: flex;
    flex-direction: column;
}

.load-controls {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 14px; /* Increased from 10px */
}

.path-section {
    margin-top: 14px; /* Increased from 10px */
    display: flex;
    flex-direction: row;
    gap: 8px; /* Increased from 5px */
    width: 100%;
}

.sample-list {
    flex: 1;
    min-height: 350px; /* Increased from 300px */
    overflow-y: auto;
    background-color: #2c3e50;
    padding: 12px; /* Increased from 8px */
    border-radius: 8px; /* Increased from 6px */
    display: flex;
    flex-direction: column;
    gap: 8px; /* Increased from 6px */
}

.sample-project:hover {
    background-color: #00aced;
}

.sample-project.active {
    background-color: #27ae60;
    font-weight: bold;
}

#tab-load-div .sample-list {
    max-height: 350px; /* Increased from 300px */
    overflow-y: auto;
    background-color: #2c3e50;
    padding: 12px; /* Increased from 8px */
    border-radius: 8px; /* Increased from 6px */
    display: flex;
    flex-direction: column;
    gap: 8px; /* Increased from 6px */
}

.load-dir-input {
    flex: 1;
    padding: 12px 14px; /* Increased from 8px 10px */
    font-size: 16px; /* Increased from 14px */
    border-radius: 8px; /* Increased from 6px */
    background-color: #2c3e50;
    color: white;
}

.input-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px; /* Increased from 10px */
}

#projector-resource-dialog > #scrollbarvertical {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 12px; /* Increased from 10px */
    pointer-events: auto;
}

#scrollbarvertical {
    position:absolute;
}

slidertrack {
}
sliderbar {
}
scrollbarvertical {
    max-width:0px;
}

.projector-grid {
    gap: 15px; /* Increased from 10px */
}